# 覆盖率配置。
#
# 反外审附加修正:原先 `source = src` 且 `fail_under = 80`,而
#   ① 骨架期 `src/` 是空的;② 本仓的脚本**几乎全部通过 subprocess 驱动**,
#     进程内覆盖率看不见它们 —— 于是实测 TOTAL 741 条语句、覆盖率 **0.00%**。
#   这个门禁**永远不可能通过**,也**从来没测到过任何东西**:
#   和 H1/H6 是同一类病(门禁空转 / 从不生效)。
#
# 现在:
#   · `source` 同时覆盖 `src`(项目代码)与 `scripts`(harness 自身代码);
#   · `parallel = True` + conftest.py 注入的 `COVERAGE_PROCESS_START`,
#     让 subprocess 里的脚本也被真正计入;
#   · `fail_under` **不在这里**(否则 pytest 一跑就红)——
#     改由 `make coverage` 执行,并在骨架期显式标注"尚无代码可测"。

[run]
branch = True
source =
    src
    scripts
parallel = True
omit =
    */tests/*
    */__init__.py
    */migrations/*
    */venv/*
    */.venv/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

show_missing = True
skip_covered = False
