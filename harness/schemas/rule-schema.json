{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Rule",
  "type": "object",
  "required": ["id", "rule", "reason", "check", "priority", "owner", "source"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" },
    "rule": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "counter_example": { "type": "string" },
    "example": { "type": "string" },
    "check": { "type": "string", "minLength": 1 },
    "test": { "type": "string", "minLength": 1 },
    "priority": { "enum": ["P0", "P1", "P2"] },
    "owner": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "history": { "type": "array" }
  },
  "allOf": [
    {
      "_comment": "反外审 H10:本仓 doctrine 是「每条 P0 规则必须有测试」(harness/rules/_template.md 填充指南),而 test 原先不在 required 里 —— 自称的硬约束其实没强制。这里按 doctrine 精确编码:仅 P0 强制带 test。",
      "if": {
        "properties": { "priority": { "const": "P0" } },
        "required": ["priority"]
      },
      "then": { "required": ["test"] }
    }
  ]
}
